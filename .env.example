# Claude API (https://platform.claude.com) — required for analysis and writing
ANTHROPIC_API_KEY=

# Google OAuth client (Web application) — required for Docs/Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional
# RESUMASTER_SPEND_LIMIT=5             # default monthly AI budget in USD (editable in the app)
# RESUMASTER_PER_APP_LIMIT=1           # default per-application AI budget in USD
# RESUMASTER_MOCK_AI=1                 # fixture responses for every AI task: UI work without spending
# RESUMASTER_PUBLIC_DEMO=1             # public portfolio deploy: serves ONLY /demo with fictional data
# DEMO_LIVE=1                          # allow live AI runs in the public demo (off by default when public)
# DEMO_RUNS_PER_HOUR=3                 # per-IP live demo rate limit
